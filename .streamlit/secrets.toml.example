# Streamlit Secrets Configuration Example
#
# FOR LOCAL DEVELOPMENT:
# 1. Copy this file to '.streamlit/secrets.toml'
# 2. Replace 'hf_your_huggingface_read_token_here' with your real Hugging Face user access token.
#
# FOR STREAMLIT COMMUNITY CLOUD DEPLOYMENT:
# In your Streamlit Cloud app dashboard:
# 1. Click "App settings" -> "Secrets"
# 2. Paste the line below with your real token:
#
# HF_TOKEN = "hf_your_token_value_here"

HF_TOKEN = "hf_your_huggingface_read_token_here"
